# RepoMap Environment Variables Example
# Copy this file to .env.local to configure your local environment.

# Optional: GitHub Personal Access Token to raise REST API rate limits from 60/hr to 5,000/hr
# Format: ghp_... or github_pat_...
GITHUB_TOKEN=your_github_token_here

# LLM Provider Configuration (OpenAI-compatible endpoint)
# Supports OpenAI, Gemini (via OpenAI compatibility endpoint), Groq, Together, Ollama, etc.
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: Watsonx provider adapter (used when LLM_PROVIDER=watsonx)
# LLM_PROVIDER=openai
# WATSONX_API_KEY=your_ibm_cloud_api_key
# WATSONX_PROJECT_ID=your_watsonx_project_id
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
