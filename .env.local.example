# RepoMap Environment Variables Example
# Copy this file to .env.local to configure your local environment.

# Optional: GitHub Personal Access Token to raise REST API rate limits from 60/hr to 5,000/hr
# Format: ghp_... or github_pat_...
GITHUB_TOKEN=your_github_token_here

# ---------------------------------------------------------------------------
# OPTION 1: Groq Free Tier (Fastest LPU Inference, Free API Key at console.groq.com)
# When GROQ_API_KEY is provided, RepoMap automatically routes to Groq
# using llama-3.3-70b-versatile with automatic fallback to llama-3.1-8b-instant.
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here

# ---------------------------------------------------------------------------
# OPTION 2: OpenAI / Generic OpenAI-Compatible Providers
# (OpenAI, Gemini via /v1/chat/completions, Together, Ollama, etc.)
# ---------------------------------------------------------------------------
# LLM_API_KEY=your_llm_api_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# OPTION 3: IBM Watsonx Provider Adapter (used when LLM_PROVIDER=watsonx)
# ---------------------------------------------------------------------------
# LLM_PROVIDER=watsonx
# WATSONX_API_KEY=your_ibm_cloud_api_key
# WATSONX_PROJECT_ID=your_watsonx_project_id
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
